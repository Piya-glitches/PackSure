# Local dev default (zero setup):
DATABASE_URL=sqlite:///./packsure.db
# Production: DATABASE_URL=postgresql://user:password@host:5432/packsure

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Load models at startup (recommended). false = faster boot for UI-only work.
PRELOAD_MODELS=true

# --- Layer 3: Qwen2.5-VL via Ollama --------------------------------------
# Local:            http://localhost:11434
# Colab T4 tunnel:  https://<your-tunnel>.trycloudflare.com   (see MIGRATION.md)
# Docker on host:   http://host.docker.internal:11434
ENABLE_VLM=true
OLLAMA_URL=http://localhost:11434
VLM_MODEL_NAME=qwen2.5vl:3b
VLM_TIMEOUT_SECONDS=120
VLM_MAX_SIDE=1280

# Optional fine-tuned DistilBERT line classifier (models/distilbert-lmpc-ner/)
ENABLE_LINE_CLASSIFIER=false

# Quality gate blur threshold (Laplacian variance on the dewarped label)
BLUR_VARIANCE_THRESHOLD=40
